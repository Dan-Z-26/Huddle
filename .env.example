# Huddle runs with NO keys in demo mode: every agent falls back to deterministic heuristics.
# Add a Gemini key (the default provider) to turn on the real models.
GEMINI_API_KEY=
# Optional second provider, for individual agents or as a fallback.
ANTHROPIC_API_KEY=

# Model ids are never hard-coded. Set one fast model and one stronger model per provider.
# Fast: Planner, Discovery, Timeline, Notices. Smart: Budget, Vendor, Ideas.
# Gemini ids (https://ai.google.dev/gemini-api/docs/models): the "-latest" aliases track the newest
# stable release; pin a specific id such as gemini-3.8-flash when you want repeatable behaviour.
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-flash-latest
# Anthropic ids: see https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_FAST_MODEL=
ANTHROPIC_SMART_MODEL=

# Default provider for every agent: gemini or anthropic.
LLM_PROVIDER=gemini
# On a 429 / 5xx / timeout, retry once on this provider if its key and model are set.
FALLBACK_PROVIDER=
FALLBACK_MODEL=

# Per-agent overrides, e.g. BUDGET_PROVIDER=anthropic or BUDGET_MODEL=...
# <AGENT> is one of: PLANNER, DISCOVERY, BUDGET, VENDOR, TIMELINE, NOTICES, IDEAS

# Model call timeout in milliseconds (default 20000; three times that when a file is attached). On a timeout, 429 or 5xx, the agent tries
# FALLBACK_PROVIDER if set, otherwise this provider's other model tier.
LLM_TIMEOUT_MS=20000

PORT=3000
# Minutes a pinned directive may wait for a "Got it" before the Timeline agent reminds people.
DIRECTIVE_SLA_MINUTES=120
# Behind a hosting proxy, the number of proxy hops (usually 1), so rate limits see real client IPs.
TRUST_PROXY_HOPS=0
# The demo sign-in lists seeded people with no password. Set to off to close it; invite links still work.
DEMO_SIGNIN=on
