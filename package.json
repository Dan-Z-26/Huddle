{
  "name": "huddle",
  "version": "0.1.0",
  "description": "A GenAI planning assistant and team workspace for weddings, birthdays, community events and product launches.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dan-Z-26/Huddle.git"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
